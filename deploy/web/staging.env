# Frontend build flags for the `staging` environment (P3-07 / P4-02).
# Public values only (Vite inlines VITE_* into the bundle). VITE_API_URL is
# not here: the deploy workflow sets it to the staging API's Cloud Run URL.
# Supabase build variables come from the GitHub environment's variables.
VITE_QCOMPASS_MULTIDOMAIN=true
VITE_QCOMPASS_CHEMISTRY=true
VITE_QCOMPASS_CONDMAT=true
VITE_QCOMPASS_AMO=true
VITE_QCOMPASS_HEP=true
VITE_QCOMPASS_NUCLEAR=true
VITE_QCOMPASS_GRAVITY=true
VITE_QCOMPASS_STATMECH=true
VITE_QCOMPASS_AUTH=true
VITE_QCOMPASS_OBSERVABILITY=true
VITE_LIVE_DOMAIN_STREAM=false
