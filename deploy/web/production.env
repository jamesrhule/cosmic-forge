# Frontend build flags for the `production` environment (P3-07 / P4-02).
# Public values only. VITE_API_URL is set by the deploy workflow to the
# production API's Cloud Run URL. Domains stay behind their flags until the
# verdict pipeline marks them DELIVERED (R18); cosmology is always on.
VITE_QCOMPASS_MULTIDOMAIN=false
VITE_QCOMPASS_CHEMISTRY=false
VITE_QCOMPASS_CONDMAT=false
VITE_QCOMPASS_AMO=false
VITE_QCOMPASS_HEP=false
VITE_QCOMPASS_NUCLEAR=false
VITE_QCOMPASS_GRAVITY=false
VITE_QCOMPASS_STATMECH=false
VITE_QCOMPASS_AUTH=true
VITE_QCOMPASS_OBSERVABILITY=false
VITE_LIVE_DOMAIN_STREAM=false
