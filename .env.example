# Environment variables read by QCompass. Names only — never commit values
# (PLAN.md R9). Copy to `.env` for local development; `.env` is git-ignored.
# A missing secret reports BLOCKED-ON-JAMES:<NAME> and the feature degrades.

# ── Frontend build (Vite inlines VITE_* at build time; public values) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_API_URL=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_PLAUSIBLE_DOMAIN=

# Feature flags ("true" / "1" to enable)
VITE_QCOMPASS_MULTIDOMAIN=
VITE_QCOMPASS_CHEMISTRY=
VITE_QCOMPASS_CONDMAT=
VITE_QCOMPASS_AMO=
VITE_QCOMPASS_HEP=
VITE_QCOMPASS_NUCLEAR=
VITE_QCOMPASS_GRAVITY=
VITE_QCOMPASS_STATMECH=
VITE_QCOMPASS_AUTH=
VITE_QCOMPASS_OBSERVABILITY=
VITE_LIVE_DOMAIN_STREAM=
VITE_DOMAINS_REGISTRY=

# ── Worker SSR (Cloudflare vars/secrets; process.env via nodejs_compat) ──
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret — server only, never VITE_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=

# ── Python backend / packages ──
UCGLE_F1_STATE_DIR=
UCGLE_F1_ARTIFACTS=
VIZ_ARTIFACTS=
VLLM_URL=
QCOMPASS_ARTIFACTS=
QCOMPASS_BENCH_DB=
QCOMPASS_CALIBRATION_DB=
QCOMPASS_PRICING_CACHE=
# "1" opts in to live provider pricing fetches (never in tests, R8).
QCOMPASS_PRICING_LIVE=
# Development only: allow unauthenticated API calls. Never set in production.
QCOMPASS_DEV_ALLOW_ANONYMOUS=
