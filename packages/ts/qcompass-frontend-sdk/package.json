{
  "name": "@qcompass/frontend-sdk",
  "version": "0.1.0",
  "description": "QCompass frontend SDK — typed client for the compute API, types generated from its OpenAPI document (P4-02).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./services": {
      "types": "./src/services.ts",
      "import": "./src/services.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./src/api.ts"
    }
  },
  "scripts": {
    "regen-types": "bash ../../../scripts/gen_sdk_types.sh",
    "check-types": "bash ../../../scripts/gen_sdk_types.sh --check"
  },
  "engines": {
    "node": ">=18"
  }
}
