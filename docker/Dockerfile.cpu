# QCompass compute images, CPU (P3-07).
#
# One Python environment, two images (PLAN Part 4: one worker image, the
# compute class chosen by --classes):
#   --target api     -> qcompass-api     (FastAPI compute API on $PORT)
#   --target worker  -> qcompass-worker  (python -m qcompass_worker)
# With no --target the last stage (api) is built, as release-please's
# ghcr.io/jamesrhule/qcompass-runtime:cpu has always been the API server.
#
# Pinned: Python 3.12.15 on Debian bookworm (slim) by digest, uv 0.11.32,
# every Python dependency from uv.lock (--frozen; R17). Runs as the
# unprivileged user `qcompass` (uid 10001). Configuration comes only from
# the environment (R9); see docs/qcompass/deployment.md. Development-only
# anonymous access is never enabled here: QCOMPASS_ENV defaults to
# production and the dev-only anonymous flag is never set
# (backend/tests/test_deploy_config.py).
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.cpu --target api    -t qcompass-api .
#   docker build -f docker/Dockerfile.cpu --target worker -t qcompass-worker .

ARG PYTHON_IMAGE=python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
ARG UV_IMAGE=astral/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c

FROM ${UV_IMAGE} AS uv

# ── build: resolve the locked environment ────────────────────────────
FROM ${PYTHON_IMAGE} AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/qcompass/.venv
# No system packages: every locked dependency ships a manylinux/pure-Python
# wheel (the one sdist, antlr4-python3-runtime, is pure Python), and the
# numerical wheels vendor their own BLAS/OpenMP runtimes.
WORKDIR /opt/qcompass
COPY pyproject.toml uv.lock README.md ./
COPY backend backend
COPY packages packages
COPY workers workers
COPY supabase/migrations supabase/migrations
# The API, the worker and every domain plugin, without dev tooling.
RUN uv sync --frozen --no-dev --all-packages --extra qcompass --extra viz \
    && rm -rf /root/.cache

# ── runtime: no compilers, unprivileged user ─────────────────────────
FROM ${PYTHON_IMAGE} AS runtime
ARG VERSION=0.0.0-dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="qcompass" \
      org.opencontainers.image.description="QCompass compute API and worker (CPU)" \
      org.opencontainers.image.source="https://github.com/jamesrhule/cosmic-forge" \
      org.opencontainers.image.url="https://github.com/jamesrhule/cosmic-forge" \
      org.opencontainers.image.documentation="https://github.com/jamesrhule/cosmic-forge/blob/main/docs/qcompass/deployment.md" \
      org.opencontainers.image.vendor="Project Human City" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="docker.io/library/python:3.12.15-slim-bookworm"
RUN groupadd --system --gid 10001 qcompass \
    && useradd --system --uid 10001 --gid qcompass --home-dir /var/lib/qcompass \
        --shell /usr/sbin/nologin qcompass \
    && mkdir -p /var/lib/qcompass/artifacts \
    && chown -R qcompass:qcompass /var/lib/qcompass
COPY --from=build --chown=root:root /opt/qcompass /opt/qcompass
ENV PATH=/opt/qcompass/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/var/lib/qcompass \
    QCOMPASS_ENV=production \
    UCGLE_F1_STATE_DIR=/var/lib/qcompass \
    UCGLE_F1_ARTIFACTS=/var/lib/qcompass/artifacts \
    QCOMPASS_PRICING_CACHE=/var/lib/qcompass/pricing \
    PORT=8080
WORKDIR /var/lib/qcompass
USER 10001:10001

# ── worker: python -m qcompass_worker --classes … ────────────────────
FROM runtime AS worker
LABEL org.opencontainers.image.title="qcompass-worker"
# The worker serves GET /healthz on $PORT (ucgle_f1.worker.serve_health):
# 200 while its loop turns or a job runs. Cloud Run probes the same path.
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('PORT', '8080')}/healthz\", timeout=4)"]
ENTRYPOINT ["python", "-m", "qcompass_worker"]
CMD ["--classes", "cpu"]

# ── api: the compute API (default target) ────────────────────────────
FROM runtime AS api
LABEL org.opencontainers.image.title="qcompass-api"
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('PORT', '8080')}/healthz\", timeout=4)"]
CMD ["sh", "-c", "exec uvicorn ucgle_f1.m8_agent.server:build_app --factory --host 0.0.0.0 --port \"${PORT:-8080}\" --proxy-headers --forwarded-allow-ips='*'"]
